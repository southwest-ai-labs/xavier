{
  "name": "xavier-monorepo",
  "private": true,
  "version": "0.2.21",
  "workspaces": [
    "panel-ui",
    "docs/site"
  ],
  "scripts": {
    "install:all": "pnpm install -r",
    "build": "pnpm --filter xavier-panel-ui run build && pnpm --filter xavier-docs-site run build",
    "build:panel": "pnpm --filter xavier-panel-ui run build",
    "build:docs": "pnpm --filter xavier-docs-site run build",
    "lint": "pnpm --filter xavier-panel-ui run biome:check && pnpm --filter xavier-panel-ui run typecheck",
    "prepare": "husky",
    "verify:rust": "bash scripts/verify-rust.sh",
    "verify:rust:full": "bash scripts/verify-rust.sh --full --with-data"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss-selector-parser": ">=7.1.6",
    "http-cache-semantics": "4.3.0"
  }
}
